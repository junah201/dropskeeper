---
// GitHub Pages가 없는 주소에 보여 주는 페이지(404.html). 어느 언어 주소에서 왔는지 모르므로 두 언어를 함께 보여 준다.
import { copy, href, langs } from '../i18n';
import '../styles/global.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 · DropsKeeper</title>
  </head>
  <body>
    <main class="flex min-h-screen flex-col items-center justify-center gap-10 bg-bg px-4 py-16 text-center font-sans text-ink">
      <a href={href('ko')} aria-label="DropsKeeper">
        <img src="/favicon.svg" alt="" width="40" height="40" />
      </a>
      {
        langs.map((lang) => {
          const t = copy[lang].notFound;
          return (
            <section lang={lang}>
              <h1 class="m-0 text-[22px] font-bold">{t.title}</h1>
              <p class="mt-2 text-[15px] text-sub">{t.desc}</p>
              <a href={href(lang)} class="mt-3 inline-block text-[14px] font-medium text-ink underline underline-offset-4">
                {t.home}
              </a>
            </section>
          );
        })
      }
    </main>
  </body>
</html>
