---
import { copy, href, langs, fallbackLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 링크 공유 미리보기 그림(1200×630). public/ 기준 주소 또는 전체 주소. 기본은 og/og.html로 만든 언어별 그림 */
  image?: string;
}

const { lang, title, description, image = `/og/${lang}.png` } = Astro.props;
// 같은 페이지의 다른 언어 주소. 검색 엔진이 언어별 페이지를 묶어 보게 한다.
const page = Astro.url.pathname.replace(/^\/(ko|en)\//, '').replace(/\.html$/, '');
const alt = (l: Lang) => new URL(href(l, page), Astro.site).href;
// hreflang 주소와 같은 꼴(.html 없음)로 맞춘다.
const url = alt(lang);
const ogLocale: Record<Lang, string> = { ko: 'ko_KR', en: 'en_US' };
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={url} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt(fallbackLang)} />
    <meta property="og:site_name" content="DropsKeeper" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy[lang].title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
